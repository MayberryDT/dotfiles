{
  "bar": {
    "id": "tyler.bar",
    "position": "top",
    "transparent": true,
    "centerAnchor": "tmn73.calendar",
    "layout": {
      "left": [
        {
          "id": "io.github.corck.filesearch"
        },
        {
          "id": "io.github.nousd.omamin"
        },
        {
          "id": "tyler.menu"
        },
        {
          "id": "tyler.workspaces"
        },
        {
          "id": "nixfred.pulse",
          "barSource": "ram",
          "cpu.displayMode": 0,
          "ram.groupByApp": false
        }
      ],
      "center": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "lifetime.time-visualizer",
          "defaultMode": "L",
          "expectedYears": 100,
          "lifeInputsExpanded": false
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "tmn73.calendar",
          "format": "dddd h:mm AP",
          "hiddenCalendars": []
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.media"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.zet.ibara"
        },
        {
          "id": "omaplug"
        },
        {
          "id": "io.zet.todo-list"
        },
        {
          "id": "co.animasai.rat-detective"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "io.github.nixfred.tailscale-host-monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "tyler.scratchpad"
        },
        {
          "id": "jankeesvw.meeting-recorder"
        },
        {
          "id": "tyler.juice"
        },
        {
          "id": "tyler.notifications"
        }
      ]
    },
    "modes": {
      "focus": {
        "keep": [
          "io.zet.ibara",
          "omarchy.media",
          "omarchy.workspaces",
          "tyler.juice",
          "tyler.media",
          "tyler.notifications",
          "tyler.workspaces"
        ]
      },
      "meeting": {
        "promote": [
          "omarchy.microphone",
          "jankeesvw.meeting-recorder",
          "tmn73.calendar"
        ],
        "calendar": "tmn73.calendar",
        "recorder": "jankeesvw.meeting-recorder"
      },
      "away": {
        "minutes": 5,
        "opacity": 0.15
      }
    }
  },
  "version": 1,
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.osd"
  ],
  "idle": {
    "lock": 2147483,
    "screensaver": 2147483
  },
  "plugins": [
    {
      "id": "bobbynicholas.omaland"
    },
    {
      "id": "io.zet.workspace-switcher"
    },
    {
      "id": "mirador"
    },
    {
      "id": "tyler.moments"
    },
    {
      "id": "tyler.notifications"
    },
    {
      "id": "tyler.osd"
    }
  ],
  "cloneSourceRestores": [
    "tyler.menu"
  ]
}
