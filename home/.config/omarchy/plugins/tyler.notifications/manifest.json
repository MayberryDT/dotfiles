{
  "schemaVersion": 1,
  "id": "tyler.notifications",
  "name": "My Notifications",
  "version": "1.1.0",
  "author": "Omarchy",
  "description": "Notification daemon, bar inbox, DND, and history. Toasts stay off; notifications go to the bar chip.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Notifications",
    "description": "Inbox and Do Not Disturb",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false
  },
  "omarchy": {
    "clonedFrom": "omarchy.notifications"
  }
}
