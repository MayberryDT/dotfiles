#!/bin/bash

# Record only the webcam (plus microphone) with gpu-screen-recorder; no screen.
# Shares Omarchy's recording state so the bar indicator, Alt+Print, and
# `omarchy-capture-screenrecording --stop-recording` stop and finalize it.

if pgrep -f "^gpu-screen-recorder" >/dev/null; then
  exec omarchy-capture-screenrecording --stop-recording
fi

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"
RECORDING_FILE="/tmp/omarchy-screenrecord-filename"

if [[ ! -d $OUTPUT_DIR ]]; then
  omarchy-notification-send -u critical -t 3000 "Screen recording directory does not exist: $OUTPUT_DIR"
  exit 1
fi

mapfile -t devices < <(omarchy-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  omarchy-notification-send "No webcam devices found" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(omarchy-menu-select "Select Webcam" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

filename="$OUTPUT_DIR/webcam-$(date +'%Y-%m-%d_%H-%M-%S').mp4"

gpu-screen-recorder -w "$device" -k auto -f 30 -fm cfr -fallback-cpu-encoding yes \
  -a default_input -ac aac -o "$filename" 2>/dev/null &
pid=$!

while kill -0 $pid 2>/dev/null && [[ ! -f $filename ]]; do
  sleep 0.2
done

if kill -0 $pid 2>/dev/null; then
  echo "$filename" >"$RECORDING_FILE"
  omarchy-shell -q omarchy.indicators refresh
else
  omarchy-notification-send -u critical -t 5000 "Webcam recording failed to start" "$device may be in use by another app"
  exit 1
fi
