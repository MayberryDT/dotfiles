#!/usr/bin/env python3
"""Write the active Omarchy palette as CSS for the local X extension."""

import os
import json
from pathlib import Path
import re
import tomllib

theme = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
output = Path.home() / ".local/share/zet-x-compose/extension/palette.css"
browser_theme = Path.home() / ".local/share/zet-x-compose/browser-theme/manifest.json"
colors = tomllib.loads(theme.read_text())


def color(key, fallback):
    value = colors.get(key, fallback)
    if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return fallback
    return value


light = colors.get("mode") == "light"
background = color("background", "#FFFFFF" if light else "#000000")
surface = color("lighter_background" if light else "dark_background", background)
hover = color("darker_background" if light else "lighter_background", surface)
foreground = color("foreground", "#171717" if light else "#F7F9F9")
muted = color("dark_foreground", foreground)
accent = color("accent", foreground)
link = color("blue", accent)
border = color("muted", hover)
selection = color("selection_background", hover)
selection_text = color("selection_foreground", foreground)


def readable_on(hex_color):
    channels = [int(hex_color[i : i + 2], 16) / 255 for i in (1, 3, 5)]
    linear = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels]
    luminance = sum(a * b for a, b in zip(linear, (0.2126, 0.7152, 0.0722)))
    return "#171717" if luminance > 0.179 else "#FFFFFF"


css = f"""/* Generated from the active Omarchy theme. */
:root {{
  --zet-x-bg: {background};
  --zet-x-surface: {surface};
  --zet-x-hover: {hover};
  --zet-x-fg: {foreground};
  --zet-x-muted: {muted};
  --zet-x-accent: {accent};
  --zet-x-link: {link};
  --zet-x-accent-fg: {readable_on(accent)};
  --zet-x-border: {border};
}}
html, body, #react-root, #react-root > div {{
  color: var(--zet-x-fg) !important;
  background-color: var(--zet-x-bg) !important;
}}
body, [data-testid="primaryColumn"], [data-testid="sidebarColumn"],
header[role="banner"], [data-testid="cellInnerDiv"],
[data-testid="DMDrawer"], [data-testid="BottomBar"],
div[role="dialog"], div[role="menu"], [role="listbox"],
[data-testid="sheetDialog"] {{
  color: var(--zet-x-fg) !important;
  background-color: var(--zet-x-bg) !important;
}}
/* X paints the post header and right rail with opaque stock-white nested divs.
   Let the themed column show through instead of leaving rectangular patches. */
#react-root [data-testid="primaryColumn"] > div:first-child > div:first-child,
#react-root [data-testid="primaryColumn"] > div:first-child > div:first-child div {{
  background-color: var(--zet-x-bg) !important;
}}
#react-root [data-testid="sidebarColumn"] div {{
  background-color: transparent !important;
}}
#react-root [data-testid="sidebarColumn"] [data-testid="SearchBox_Search_Input"] {{
  background-color: var(--zet-x-surface) !important;
}}
/* Search, composer and timeline tabs have stock white/grey wrappers. */
#react-root [data-testid="sidebarColumn"] div:has(> [data-testid="SearchBox_Search_Input"]),
#react-root [data-testid="sidebarColumn"] div:has(> div > [data-testid="SearchBox_Search_Input"]) {{
  background-color: var(--zet-x-surface) !important;
  border-radius: 9999px !important;
}}
#react-root [data-testid="primaryColumn"] div:has(> [data-testid="toolBar"]),
#react-root [data-testid="primaryColumn"] div:has(> div > [data-testid="toolBar"]),
#react-root [data-testid="primaryColumn"] [data-testid="toolBar"],
#react-root [data-testid="primaryColumn"] [data-testid="toolBar"] div {{
  background-color: var(--zet-x-bg) !important;
}}
#react-root [data-testid="primaryColumn"] [role="tablist"],
#react-root [data-testid="primaryColumn"] [role="tab"],
#react-root [data-testid="primaryColumn"] [role="tab"] div {{
  background-color: transparent !important;
  border-color: var(--zet-x-border) !important;
}}
div[role="dialog"] [data-testid="tweetTextarea_0"],
input, textarea, [contenteditable="true"] {{
  color: var(--zet-x-fg) !important;
  caret-color: var(--zet-x-accent) !important;
}}
::selection {{ color: {selection_text}; background: {selection}; }}
a[href*="/hashtag/"], a[href^="https://t.co/"] {{ color: var(--zet-x-link) !important; }}
/* X's default bright blue is used for links, prompts, and verified badges. */
#react-root [class*="r-1cvl2hr"],
#react-root [data-zet-x-link],
#react-root [data-testid="icon-verified"],
#react-root svg[aria-label="Verified account"] {{ color: var(--zet-x-link) !important; }}
#react-root [data-testid="icon-verified"] path:first-child,
#react-root svg[aria-label="Verified account"] path:first-child {{
  fill: var(--zet-x-link) !important;
}}
[data-testid="primaryColumn"] > div, [data-testid="cellInnerDiv"],
[data-testid="sidebarColumn"] > div, header[role="banner"],
[role="dialog"], [role="menu"], [role="listbox"] {{
  border-color: var(--zet-x-border) !important;
}}
[data-testid="SearchBox_Search_Input"],
[data-testid="typeaheadRecentSearches"], [data-testid="toolBar"],
[data-testid="HoverCard"], [data-testid="card.wrapper"] {{
  color: var(--zet-x-fg) !important;
  background-color: var(--zet-x-surface) !important;
}}
[data-testid="tweetButton"], [data-testid="tweetButtonInline"],
[data-testid="SideNav_NewTweet_Button"] {{
  color: var(--zet-x-accent-fg) !important;
  background-color: var(--zet-x-accent) !important;
}}
[data-testid="cellInnerDiv"]:hover, [role="menuitem"]:hover {{
  background-color: var(--zet-x-hover) !important;
}}
/* The fixed Grok/chat launchers use their own untinted white cards. */
#react-root [data-testid="DMDrawer"],
#react-root [data-testid*="GrokDrawer"],
#react-root [data-zet-x-floating],
#react-root :is(button, [role="button"])[aria-label="Grok"],
#react-root :is(button, [role="button"])[aria-label="Chat"] {{
  color: var(--zet-x-fg) !important;
  background-color: var(--zet-x-surface) !important;
  border-color: var(--zet-x-border) !important;
  box-shadow: 0 2px 9px color-mix(in srgb, var(--zet-x-fg) 12%, transparent) !important;
}}
/* X puts its stock palette on many anonymous layout nodes. Match those
   exact values so media, profile images, and custom post colors stay intact. */
[style*="background-color: rgb(0, 0, 0)"],
[style*="background-color: rgb(255, 255, 255)"],
[style*="background-color: rgb(21, 32, 43)"] {{
  background-color: var(--zet-x-bg) !important;
}}
[style*="background-color: rgb(32, 35, 39)"],
[style*="background-color: rgb(239, 243, 244)"] {{
  background-color: var(--zet-x-surface) !important;
}}
span[style*="color: rgb(231, 233, 234)"],
span[style*="color: rgb(15, 20, 25)"],
[dir="auto"][style*="color: rgb(231, 233, 234)"],
[dir="auto"][style*="color: rgb(15, 20, 25)"] {{ color: var(--zet-x-fg) !important; }}
span[style*="color: rgb(113, 118, 123)"],
span[style*="color: rgb(139, 152, 165)"] {{ color: var(--zet-x-muted) !important; }}
span[style*="color: rgb(29, 155, 240)"],
a[style*="color: rgb(29, 155, 240)"] {{ color: var(--zet-x-link) !important; }}
[data-testid="tweetButton"] *, [data-testid="tweetButtonInline"] *,
[data-testid="SideNav_NewTweet_Button"] * {{ color: inherit !important; }}
"""

output.parent.mkdir(parents=True, exist_ok=True)
temp = output.with_name(".palette.css.tmp")
temp.write_text(css)
os.replace(temp, output)


def rgb(value):
    return [int(value[i : i + 2], 16) for i in (1, 3, 5)]


# Browser chrome is separate from the X page. A Chrome theme colors its tabs,
# toolbar and address field after Brave next loads the unpacked theme extension.
browser_theme.parent.mkdir(parents=True, exist_ok=True)
manifest = {
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Omarchy browser chrome",
    "theme": {
        "colors": {
            "frame": rgb(color("darker_background", background)),
            "frame_inactive": rgb(color("dark_background", background)),
            "toolbar": rgb(background),
            "tab_text": rgb(foreground),
            "tab_background_text": rgb(foreground),
            "bookmark_text": rgb(foreground),
            "toolbar_button_icon": rgb(foreground),
            "omnibox_background": rgb(surface),
            "omnibox_text": rgb(foreground),
            "ntp_background": rgb(background),
            "ntp_text": rgb(foreground),
        }
    },
}
browser_temp = browser_theme.with_name(".manifest.json.tmp")
browser_temp.write_text(json.dumps(manifest, indent=2) + "\n")
os.replace(browser_temp, browser_theme)
