#!/usr/bin/env python3
"""Write the active Omarchy palette as CSS for the local X extension."""

import os
import json
from pathlib import Path
import re
import tomllib

theme = Path.home() / ".local/state/omarchy/current/theme/colors.toml"
output = Path.home() / ".local/share/zet-x-compose/extension/palette.css"
browser_theme = Path.home() / ".local/share/zet-x-compose/browser-theme/manifest.json"
colors = tomllib.loads(theme.read_text())


def color(key, fallback):
    value = colors.get(key, fallback)
    if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        return fallback
    return value


light = colors.get("mode") == "light"
background = color("background", "#FFFFFF" if light else "#000000")
surface = color("lighter_background" if light else "dark_background", background)
hover = color("darker_background" if light else "lighter_background", surface)
foreground = color("foreground", "#171717" if light else "#F7F9F9")
muted = color("dark_foreground", foreground)
accent = color("accent", foreground)
link = color("blue", accent)
border = color("muted", hover)
selection = color("selection_background", hover)
selection_text = color("selection_foreground", foreground)


def readable_on(hex_color):
    channels = [int(hex_color[i : i + 2], 16) / 255 for i in (1, 3, 5)]
    linear = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels]
    luminance = sum(a * b for a, b in zip(linear, (0.2126, 0.7152, 0.0722)))
    return "#171717" if luminance > 0.179 else "#FFFFFF"


css = f"""/* Generated from the active Omarchy theme. */
:root {{
  --zet-x-bg: {background};
  --zet-x-surface: {surface};
  --zet-x-hover: {hover};
  --zet-x-fg: {foreground};
  --zet-x-muted: {muted};
  --zet-x-accent: {accent};
  --zet-x-link: {link};
  --zet-x-accent-fg: {readable_on(accent)};
  --zet-x-border: {border};
}}
/* Palette only: never paint descendants or change geometry. */
html, body, #react-root {{
  color: var(--zet-x-fg) !important;
  background-color: var(--zet-x-bg) !important;
}}
#react-root :is(input, textarea, [contenteditable="true"]) {{
  color: var(--zet-x-fg) !important;
  caret-color: var(--zet-x-accent) !important;
}}
::selection {{ color: {selection_text}; background: {selection}; }}
#react-root :is([data-testid="tweetButton"], [data-testid="tweetButtonInline"],
[data-testid="SideNav_NewTweet_Button"]) {{
  background-color: var(--zet-x-accent) !important;
  color: var(--zet-x-accent-fg) !important;
}}
#react-root :is([data-testid="tweetButton"], [data-testid="tweetButtonInline"],
[data-testid="SideNav_NewTweet_Button"]) :is(div, span, svg) {{
  color: inherit !important;
}}
#react-root :is(a[href*="/hashtag/"], a[href^="https://t.co/"],
[data-testid="icon-verified"]) {{ color: var(--zet-x-link) !important; }}
/* Atomic classes also cover already-open pages until the new script loads. */
#react-root .r-14lw9ot, #react-root .r-kemksi,
#react-root .r-5zmot {{ background-color: var(--zet-x-bg) !important; }}
#react-root .r-1cvl2hr {{ color: var(--zet-x-link) !important; }}
#react-root .r-1vtznih, #react-root .r-l5o3uw {{ background-color: var(--zet-x-accent) !important; }}

"""

# Inline React colors are separate from the stylesheet rules handled by theme.js.
stock = {
    "background-color": {
        "bg": ["rgb(255, 255, 255)", "rgb(0, 0, 0)", "rgb(21, 32, 43)"],
        "surface": ["rgb(247, 249, 249)", "rgb(239, 243, 244)", "rgb(32, 35, 39)", "rgb(22, 24, 28)"],
        "hover": ["rgb(230, 236, 240)", "rgb(239, 239, 239)", "rgb(26, 26, 26)"],
        "accent": ["rgb(29, 155, 240)", "rgb(29, 161, 242)", "rgb(0, 153, 255)"],
    },
    "color": {
        "fg": ["rgb(15, 20, 25)", "rgb(231, 233, 234)", "rgb(217, 217, 217)"],
        "muted": ["rgb(83, 100, 113)", "rgb(113, 118, 123)", "rgb(139, 152, 165)"],
        "link": ["rgb(29, 155, 240)", "rgb(29, 161, 242)", "rgb(0, 153, 255)"],
    },
    "border-color": {
        "border": ["rgb(239, 243, 244)", "rgb(207, 217, 222)", "rgb(47, 51, 54)", "rgb(56, 68, 77)"],
    },
}
for prop, groups in stock.items():
    for token, values in groups.items():
        selectors = []
        for value in values:
            for spacing in ("", " "):
                declaration = f"{prop}:{spacing}{value}"
                for prefix in ("", ";", "; "):
                    operator = "^=" if not prefix else "*="
                    selectors.append(f'#react-root [style{operator}"{prefix}{declaration}"]')
        css += ",\n".join(selectors) + f" {{ {prop}: var(--zet-x-{token}) !important; }}\n"

output.parent.mkdir(parents=True, exist_ok=True)
temp = output.with_name(".palette.css.tmp")
temp.write_text(css)
os.replace(temp, output)


def rgb(value):
    return [int(value[i : i + 2], 16) for i in (1, 3, 5)]


# Browser chrome is separate from the X page. A Chrome theme colors its tabs,
# toolbar and address field after Brave next loads the unpacked theme extension.
browser_theme.parent.mkdir(parents=True, exist_ok=True)
manifest = {
    "manifest_version": 3,
    "version": "1.0.0",
    "name": "Omarchy browser chrome",
    "theme": {
        "colors": {
            "frame": rgb(color("darker_background", background)),
            "frame_inactive": rgb(color("dark_background", background)),
            "toolbar": rgb(background),
            "tab_text": rgb(foreground),
            "tab_background_text": rgb(foreground),
            "bookmark_text": rgb(foreground),
            "toolbar_button_icon": rgb(foreground),
            "omnibox_background": rgb(surface),
            "omnibox_text": rgb(foreground),
            "ntp_background": rgb(background),
            "ntp_text": rgb(foreground),
        }
    },
}
browser_temp = browser_theme.with_name(".manifest.json.tmp")
browser_temp.write_text(json.dumps(manifest, indent=2) + "\n")
os.replace(browser_temp, browser_theme)
